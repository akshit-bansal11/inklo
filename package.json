{
  "name": "inklo",
  "private": true,
  "version": "0.2.0",
  "description": "A fully local, keyboard-first notes app for Windows, macOS and Linux. Plain .md and .txt files, no network.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "tauri": "tauri",
    "check": "biome check --write . && eslint . && stylelint \"src/**/*.css\" --fix && tsc --noEmit",
    "check:ci": "biome ci . && eslint . && stylelint \"src/**/*.css\" && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.4",
    "cmdk": "1.1.1",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "lucide-react": "1.68.0",
    "marked": "18.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "turndown": "7.2.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
